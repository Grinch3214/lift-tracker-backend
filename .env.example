POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=lift_tracker
POSTGRES_HOST=localhost
POSTGRES_PORT=15434

JWT_SECRET=change-me-to-a-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=60

# Через запятую, без пробелов. Не задано — разрешён любой origin (permissive-дефолт,
# пока нет фиксированного адреса фронта). Например: https://lifttracker.example.com,http://localhost:3000
# CORS_ORIGIN=
